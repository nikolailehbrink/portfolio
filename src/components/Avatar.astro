---
import { cn } from "@/lib/utils";
import { Image } from "astro:assets";
import type { ComponentProps } from "astro/types";
import avatar from "@/assets/avatar.webp";

// `Image`'s props are a discriminated union (local/remote, widths/densities).
// A plain `Omit` collapses it into one flat type and breaks the discrimination,
// so distribute the `Omit` across each union member to keep it intact.
type DistributiveOmit<T, K extends PropertyKey> = T extends unknown
  ? Omit<T, K>
  : never;
type Props = DistributiveOmit<
  ComponentProps<typeof Image>,
  "alt" | "src" | "title"
>;
const { class: className, ...props } = Astro.props;
---

<Image
  {...props}
  class={cn("object-cover", className)}
  alt="Avatar"
  title="Profile image"
  src={avatar}
  quality="high"
  fetchpriority="high"
/>
