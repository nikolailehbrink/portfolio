---
import BaseHead from "../../components/BaseHead.astro";
import RootLayout from "@/layouts/RootLayout.astro";
import { getBlogTags, getPosts } from "@/lib/posts";
import BlogToolbar from "@/components/react/BlogToolbar";
import PostTeaser from "@/components/PostTeaser.astro";
import { track } from "@vercel/analytics/server";
import Schema from "@/components/Schema.astro";
import { breadcrumbSchema, personRef, websiteRef } from "@/lib/schema";
import { getEntries } from "astro:content";
import type { BlogPosting } from "schema-dts";

export const prerender = false;

const title = "Blog | Nikolai Lehbrink";
const description =
  "A collection of my thoughts, ideas and experiences. I write about various topics, including web development, technology and personal topics.";

const { searchParams, origin } = Astro.url;
const tagSlugs = searchParams.getAll("tag");

const tags = await getBlogTags();
const filteredTags = tags.filter(({ slug }) => tagSlugs.includes(slug));

const posts = await getPosts({ tags: filteredTags.map(({ name }) => name) });

const schemaPosts = await Promise.all(
  posts.map(async ({ data, id: slug }) => {
    const authors = await getEntries(data.authors);
    const postUrl = `${origin}/blog/${slug}`;

    return {
      "@type": "BlogPosting",
      // Same `@id` as the actual post page, so the two references resolve to a
      // single entity in the knowledge graph rather than duplicating it.
      "@id": `${postUrl}#article`,
      url: postUrl,
      mainEntityOfPage: { "@id": postUrl },
      headline: data.title,
      description: data.description,
      datePublished: data.publicationDate.toISOString(),
      dateModified: (
        data.modificationDate ?? data.publicationDate
      ).toISOString(),
      author:
        authors[0].id === "nikolailehbrink"
          ? personRef(origin)
          : { "@type": "Person", name: authors[0].data.name },
      keywords: data.tags?.join(", "),
    } satisfies BlogPosting;
  }),
);

if (filteredTags.length > 0) {
  await track("blog-tag-filtered", {
    tag: filteredTags.map(({ name }) => name).join(", "),
  });
}
---

<RootLayout>
  <BaseHead title="Blog" description={description} slot="head">
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "Blog",
        "@id": `${origin}/blog#blog`,
        url: `${origin}/blog`,
        name: title,
        description,
        inLanguage: "en",
        isPartOf: websiteRef(origin),
        publisher: personRef(origin),
        blogPost: schemaPosts,
      }}
    />
    <Schema
      item={breadcrumbSchema(origin, [
        { name: "Home", url: "/" },
        { name: "Blog", url: "/blog" },
      ])}
    />
  </BaseHead>
  <div class="flex flex-col gap-4 sm:items-center">
    <h1 class="text-3xl font-bold sm:text-center sm:text-4xl">Blog</h1>
    <p class="max-w-prose text-muted-foreground sm:text-center">
      {description}
    </p>
    <BlogToolbar
      client:load
      tags={tags}
      activeTagSlugs={filteredTags.map(({ slug }) => slug)}
      className="mt-4 w-full lg:max-w-5xl"
    />
    <ul
      id="blog-list"
      class="mt-2 grid grid-cols-1 gap-4 rounded-md md:grid-cols-2 lg:max-w-5xl"
    >
      {
        posts.length > 0 ? (
          posts.map(({ data, id, readingTime }) => (
            <PostTeaser
              post={{
                ...data,
                slug: id,
                readingTime,
              }}
            />
          ))
        ) : (
          <p
            class="col-span-2 rounded-lg bg-card p-4 py-3 text-center
              text-muted-foreground"
          >
            No posts were found{" "}
            {filteredTags.length > 0
              ? `for ${filteredTags.map(({ name }) => name).join(", ")}.`
              : "."}{" "}
            <br />
          </p>
        )
      }
    </ul>
    <p
      id="blog-search-empty"
      class="hidden rounded-lg bg-card p-4 py-3 text-center
        text-muted-foreground"
    >
      No posts match your search.
    </p>
  </div>
</RootLayout>
